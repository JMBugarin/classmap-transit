{
	admin off
}

{$PUBLIC_HOST} {
	@activity {
		path /v1/activity
		method POST DELETE OPTIONS
	}
	@feedback {
		path /v1/room-feedback
		method POST OPTIONS
	}
	@read {
		path /v1/departures /v1/feed-status
		method GET
	}
	handle @activity {
		request_body {
			max_size 1KB
		}
		reverse_proxy api:8080 {
			header_up -X-Forwarded-For
			header_up -X-Real-IP
		}
	}
	handle @feedback {
		request_body {
			max_size 2KB
		}
		reverse_proxy api:8080 {
			header_up -X-Forwarded-For
			header_up -X-Real-IP
		}
	}
	handle @read {
		request_body {
			max_size 1KB
		}
		reverse_proxy api:8080 {
			header_up -X-Forwarded-For
			header_up -X-Real-IP
		}
	}
	handle {
		respond 404
	}
}
